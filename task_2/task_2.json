              "name": "phone_normalized",
              "value": "={{ (() => {\n  const raw = String($json.Phone ?? '').trim();\n  const digits = raw.replace(/\\D/g, '');\n\n  let mobile;\n\n  if (/^[6-9]\\d{9}$/.test(digits)) {\n    mobile = digits;\n  } else if (/^91[6-9]\\d{9}$/.test(digits)) {\n    mobile = digits.slice(2);\n  } else {\n    return null;\n  }\n\n  return `+91-${mobile}`;\n})() }}",
