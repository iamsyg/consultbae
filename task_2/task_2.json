    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst duplicates = items.filter(\n  item => item.json.alert_type === \"DUPLICATE\"\n);\n\nconst newCandidates = items.filter(\n  item => item.json.alert_type === \"NEW_CANDIDATE\"\n);\n\nreturn [\n  {\n    json: {\n      success: true,\n      total_candidates: items.length,\n      duplicates_found: duplicates.length,\n      new_candidates: newCandidates.length,\n\n      duplicates: duplicates.map(item => ({\n        candidate_name: item.json.candidate_name,\n        candidate_email: item.json.candidate_email,\n        candidate_phone: item.json.candidate_phone,\n        matched_person_id: item.json.matched_person_id,\n        matched_name: item.json.matched_name,\n        matched_email: item.json.matched_email,\n        matched_phone: item.json.matched_phone\n      })),\n\n      new_candidates: newCandidates.map(item => ({\n        candidate_name: item.json.candidate_name,\n        candidate_email: item.json.candidate_email,\n        candidate_phone: item.json.candidate_phone\n      }))\n    }\n  }\n];"
      },
